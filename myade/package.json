    "dev": "tsc -p tsconfig.json && node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.12.0",
    "cross-spawn": "^7.0.6",
    "express": "^4.19.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "zod": "3.25.76"
  }
}
